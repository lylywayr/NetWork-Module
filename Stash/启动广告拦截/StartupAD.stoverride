name: 开屏去广告
desc: 去除部分APP开屏广告

http:
  mitm:
    - "capis.didapinche.com"
    - "capis*.didapinche.com"
    - "app.bilibili.com"
    - "wmapi.meituan.com"
    - "hd.mina.mi.com"
    - "api.m.jd.com"
  script:
# 嘀嗒出行
    - match: ^https?:\/\/capis(-?\w*)?\.didapinche\.com\/ad\/cx\/startup\?
      name: dida
      type: response
      require-body: true
      timeout: 10
      timeout: 10
# 美团外卖
    - match: ^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/loadInfo?
      name: meituan
      type: response
      require-body: true
      timeout: 10
# 京东
    - match: ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start
      name: jingdong
      type: response
      require-body: true
      timeout: 10
    
script-providers:
# 嘀嗒出行
  dida:
    url: https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Stash/%E5%90%AF%E5%8A%A8%E5%B9%BF%E5%91%8A%E6%8B%A6%E6%88%AA/startup.js
    interval: 86400
  meituan:
    url: https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Stash/%E5%90%AF%E5%8A%A8%E5%B9%BF%E5%91%8A%E6%8B%A6%E6%88%AA/startup.js
    interval: 86400
# 京东
  jingdong:
    url: https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Stash/%E5%90%AF%E5%8A%A8%E5%B9%BF%E5%91%8A%E6%8B%A6%E6%88%AA/startup.js
    interval: 86400
