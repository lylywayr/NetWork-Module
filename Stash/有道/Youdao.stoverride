name: 有道云笔记
desc: 解锁VIP高级功能

http:
  mitm:
    - "note.youdao.com"
  script:
    - match: https://note.youdao.com/yws/(mapi/payment|api/self)
      name: youdao
      type: response
      requires-body: true
      timeout: 10
      
script-providers:
  youdao:
    url: https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Stash/%E6%9C%89%E9%81%93/ydybj.js
    interval: 86400
