#!name=网易严选签到
#!desc=打开严选 App 的签到活动页（act.you.163.com/act/pub/ssr/HysmFsmeKj88.html）即可抓登录态。每日自动签到，参数里可关闭抓取、改时间或通知。
#!author=脚本 ddgksf2013 / 模块 lylywayr
#!category=签到
#!arguments=cookie:true,hour:9,minute:10,notify:true
#!arguments-desc=cookie：是否自动抓取登录态，打开严选 App 的签到活动页 act.you.163.com/act/pub/ssr/HysmFsmeKj88.html 即可触发（抓到一次后可填 false 关闭）；hour / minute：每日定时执行的时、分（默认 9:10）；notify：是否推送通知，填 false 只写日志。布尔参数填 true / false。

[MITM]
hostname = %APPEND% act.you.163.com

[Script]
严选 Cookie = type=http-request, pattern=^https:\/\/act\.you\.163\.com\/act-attendance\/(?:task\/list|att\/v4\/index|att\/v3\/sign), requires-body=false, script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-YanxuanCheckin/yanxuan_daily_sign.js, argument="cookie={{{cookie}}};notify={{{notify}}}", timeout=15, img-url=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/1f/68/01/1f6801fa-504c-fbe0-c14e-8f46b8245de2/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/100x100bb.jpg
严选签到 = type=cron, cronexp="{{{minute}}} {{{hour}}} * * *", wake-system=true, timeout=60, script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-YanxuanCheckin/yanxuan_daily_sign.js, argument="cookie={{{cookie}}};notify={{{notify}}}", img-url=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/1f/68/01/1f6801fa-504c-fbe0-c14e-8f46b8245de2/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/100x100bb.jpg
