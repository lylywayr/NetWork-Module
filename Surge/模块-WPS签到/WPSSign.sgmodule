#!name=WPS Office · 每日签到 + 福利中心任务
#!desc=按 WPS Office 26.11.0（build 26.11.0193140）砸壳包逆向复核：自动抓 wps_sid，每天 10 点抢限量爆款，再做签到、智点领取、打卡领会员、天天抽奖、会员试用、福利中心领券、小程序打卡并领昨日奖励。新增 26.11.0 的 custom_page 智点活动（HD2026102710505525）；活动号、页面号、任务开关都在模块设置里改，组件号自动发现，模块本身不含任何凭证。
#!category=签到任务
#!author=WorkBuddy（任务逻辑上游 MaYIHEI/paperclip）
#!arguments=CronExp:0 10 * * *,Tasks:all,Capture:1,Learn:1,ActivityNumber:HD2025031721339450,PageNumber:YM2025060910400185,Position:ios_flzx_grzxsdjg3001,ZActivityNumber:HD2026102710505525,ZPageNumber:YM2026102710519929,AutoDiscover:1
#!arguments-desc=CronExp:每天几点跑（Cron，默认 10:00，限量爆款 10 点开抢；改成 0 10,12 * * * 可补跑，脚本自带幂等）\n\nTasks:要做的任务，all=全部；也可只写 hot,zhidian,signin,fragment,lottery,trial,coupon,clockin 中的几项，逗号分隔\n\nCapture:1=开启抓 Cookie：每次经过请求都重新抓取、写入本机并弹「抓取成功」通知；0=关闭，完全不抓不弹（已存凭证保留，定时签到照常跑）\n\nLearn:1=在 App 里手动点「领取智点」时，把真实请求结构存下来，后续定时任务照客户端结构领取；0=关\n\nActivityNumber:福利中心活动号，WPS 换活动时在这里改\n\nPageNumber:福利中心页面号，一般与活动号一起换\n\nPosition:活动页渠道位，一般不用改\n\nZActivityNumber:智点活动号（26.11.0 新增），默认 HD2026102710505525\n\nZPageNumber:智点活动页面号，默认 YM2026102710519929\n\nAutoDiscover:1=按业务字段自动对齐组件号，0=只用脚本内置编号

# ============================================================
# 安装：Surge → 模块 → 安装新模块，粘贴本文件 raw 链接即可，无需手动拷贝脚本。
# 1. 模块不含任何账号凭证。首次使用打开一次 WPS App 的「签到 / 任务中心 / 福利中心 / 智点领取」并登录，
#    wps-cookie 会在请求经过时现抓 wps_sid，写进本机 $persistentStore。
#    模块参数 Capture 可随时打开/关闭抓取；开启时每次命中都写入并弹通知，关闭不影响已存凭证与定时签到。
# 2. 四个 JS 从本仓库 main 分支 Surge/模块-WPS签到/ 目录加载，更新仓库后 Surge 会在缓存周期内自动刷新。
# 3. 智点领取走 26.11.0 新增的 custom_page/action；服务端字段未公开，脚本按
#    「学到的真实样本 → 多套结构」顺序试探，成功那次会把结构记下来，后续直接命中。
#    在 App 里手动点一次「领取智点」，wps-learn 就会把真实结构存下来（Learn=1 时）。
# 4. 长按 wps-status 运行可体检：凭证、登录态、今日签到、智点活动、小程序打卡、活动组件、领券机会、动作样本。
# 5. 详细说明见仓库 wps/README.md。
# ============================================================

[MITM]
# %APPEND% 只追加，不覆盖你原有的 MITM 域名。
# personal-act.wps.cn 是活动页与 custom_page 接口（抓凭证、学动作必需）；moapi.wps.cn 是旧版 App 配置接口，备用抓凭证入口。
hostname = %APPEND% personal-act.wps.cn, moapi.wps.cn

[Script]
# ① 抓凭证：只读请求头，不修改、不放行拦截任何流量。
#    经典活动页 page_info、26.11.0 的 custom_page 接口、任务中心、旧版 App 配置接口，任一命中即可抓住 wps_sid。
#    26.11.0 的 H5 会把 Cookie 拆成多条 `cookie:` 头，脚本已做归一化与多来源兜底。
wps-cookie = type=http-request,pattern=^https://(personal-act\.wps\.cn/activity-rubik/(activity/page_info|custom_page/info|custom_page/action|user/task_center/|rubik_extension/)|moapi\.wps\.cn/app/ios/v1/app),script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-WPS%E7%AD%BE%E5%88%B0/wps-cookie.js?v=20261121d,requires-body=false,max-size=0,full-header-mode=true,timeout=10,argument=Capture={{{Capture}}}

# ①.5 学动作样本：把你手动点「领取智点」时的真实请求体（custom_page/action）存到本机，
#     定时任务下次照抄结构。只读请求体、不改流量；Learn=0 关闭。
wps-learn = type=http-request,pattern=^https://personal-act\.wps\.cn/activity-rubik/custom_page/action,script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-WPS%E7%AD%BE%E5%88%B0/wps-learn.js?v=20261121d,requires-body=true,max-size=131072,timeout=10,argument=Learn={{{Learn}}}

# ② 定时跑全部任务：默认每天 10:00（限量爆款 10 点开抢，脚本把它排在第一位）。
#    任务逐个串行、动作间随机间隔；每项都先查状态，已签/已领自动跳过，重复运行不会重复领。
#    wake-system=true 让 iOS 用静默通知唤醒 Surge，Mac 会忽略。
wps-signin = type=cron,cronexp="{{{CronExp}}}",script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-WPS%E7%AD%BE%E5%88%B0/wps-signin.js?v=20261121d,timeout=240,wake-system=true,argument=Tasks={{{Tasks}}}&ActivityNumber={{{ActivityNumber}}}&PageNumber={{{PageNumber}}}&Position={{{Position}}}&ZActivityNumber={{{ZActivityNumber}}}&ZPageNumber={{{ZPageNumber}}}&AutoDiscover={{{AutoDiscover}}}

# ③ 体检：在 Surge 脚本页长按运行，用通知弹出凭证、登录态、签到、智点、打卡、组件、领券与样本状态。
#    传参 clear=1 可清空本机凭证（换账号时用）。
wps-status = type=generic,script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-WPS%E7%AD%BE%E5%88%B0/wps-status.js?v=20261121d,timeout=40,argument=ActivityNumber={{{ActivityNumber}}}&PageNumber={{{PageNumber}}}&Position={{{Position}}}&ZActivityNumber={{{ZActivityNumber}}}&ZPageNumber={{{ZPageNumber}}}

# ------------------------------------------------------------
# 安装链接（Surge → 模块 → 安装新模块 → 粘贴）：
#   https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-WPS%E7%AD%BE%E5%88%B0/WPSSign.sgmodule
#
# 若 Surge 仍加载旧脚本：关闭再打开模块开关，或调小 script-update-interval。
# 仓库为 Public，raw 链接可匿名访问。
# ------------------------------------------------------------
