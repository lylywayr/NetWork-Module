#!name=我的华为 · 积分签到（抓包学习 → 自动重放）
#!desc=华为手机在「我的华为」App 里签到可得积分（积分在华为商城下单可抵扣、也能在会员中心「积分兑」换东西）。华为没有公开的签到接口，社区也没有能直接用的脚本，所以这里走「学一次、每天照抄」的路子：你在 App 里手动点一次签到，huawei-learn 把那次真实请求（方法 / 完整头 / 请求体 / Cookie）存到本机，huawei-signin 每天定时原样重发；Cookie 每次打开 App 自动续期。只用于自己的华为账号。
#!category=签到任务
#!author=IrisCode（WorkBuddy 环境）
#!arguments=CronExp:5 8 * * *,Learn:1,DryRun:0,Action:list
#!arguments-desc=CronExp:每天几点重放（Cron 表达式，默认 08:05）\n\nLearn:1=开启学习：你在 App 里点签到时把真实请求存下来；0=只重放已存模板，不再学新的\n\nDryRun:1=只列出要发哪些请求、不真发包（第一次接好线先演练一次）\n\nAction:体检脚本的动作，list=列模板 / clear=清空重学 / del:序号 / off:序号 / on:序号

# ============================================================
# 用法（三步）：
# 1. 华为手机连 WiFi，HTTP 代理指向这台 iPhone 的 Surge（Surge → 设置 → 允许局域网连接，
#    并在华为手机上装好 Surge 的 CA 证书：设置里下载证书后，华为要额外在
#    「设置 → 安全 → 更多安全设置 → 加密和凭据 → 从存储设备安装」里装一次）。
# 2. 打开「我的华为」→ 我的 → 会员中心 → 点一次「签到」。屏幕上会弹出
#    「我的华为签到 · 已学到请求」的通知，说明模板已入库。
# 3. 之后每天 CronExp 时间自动重放，结果用 Surge 通知回报。
#
# 找不到签到入口时，把下面 [MITM] 的注释项（hicloud / club 等）打开再试一次；
# 华为部分系统域名的请求带证书固定，MITM 会让那次请求失败，只影响抓包，不影响签到本身。
# ============================================================

[MITM]
# %APPEND% 只追加，不覆盖你原有的 MITM 域名。
hostname = %APPEND% *.vmall.com, *.huawei.cn, consumer.huawei.com, club.huawei.com, myhuawei.huawei.com
# 若上一步没抓到，再追加这一行（云空间 / 华为云侧接口，个别接口有证书固定）：
# hostname = %APPEND% *.hicloud.com, *.dbankcloud.cn, *.dbankcloud.com, *.huawei.com

[Script]
# ① 学习器：只读响应，把疑似签到请求落库，不改流量。
huawei-learn = type=http-response,pattern=^https?://([a-z0-9-]+\.)*(vmall\.com|huawei\.cn|hicloud\.com|dbankcloud\.cn|dbankcloud\.com)/,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-%E6%88%91%E7%9A%84%E5%8D%8E%E4%B8%BA%E7%AD%BE%E5%88%B0/huawei-learn.js?v=20261125,timeout=20,argument=Learn={{{Learn}}}

# ② 定时重放：默认每天 08:05 跑，逐条串行，当天成功过的自动跳过。
huawei-signin = type=cron,cronexp="{{{CronExp}}}",script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-%E6%88%91%E7%9A%84%E5%8D%8E%E4%B8%BA%E7%AD%BE%E5%88%B0/huawei-signin.js?v=20261125,timeout=120,wake-system=true,argument=DryRun={{{DryRun}}}

# ③ 体检：长按本行 → 运行，看已学模板 / 清空重学。
huawei-status = type=cron,cronexp="0 4 1 1 *",script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-%E6%88%91%E7%9A%84%E5%8D%8E%E4%B8%BA%E7%AD%BE%E5%88%B0/huawei-status.js?v=20261125,timeout=20,argument=Action={{{Action}}}
