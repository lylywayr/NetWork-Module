#!name=TestFlight区域限制解除
#!desc=该模块适用于TestFlight更新时，提示"APP不可用"的问题。
#!system=ios
#!author=NobyDa
#!repo=https://github.com/NobyDa/Script/tree/master

[General]
skip-proxy = %APPEND% iosapps.itunes.apple.com

[Script]
TestFlight下载修正 = type=http-request,script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-TestFlight%E8%B4%A6%E6%88%B7%E7%AE%A1%E7%90%86/94e30f41890b0534a28ac4e45edb8c76.js,pattern="^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/.+?\/install$",requires-body=1,argument="\d+-\d+,\d+->143441-19,29"

[MITM]
hostname = %APPEND% testflight.apple.com
