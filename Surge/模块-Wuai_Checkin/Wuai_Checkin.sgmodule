#!name=吾爱破解签到
#!desc=打开 52pojie.cn 登录后自动抓取 Cookie，每天定时自动签到。抓取可用参数关闭；签到脚本来自 Yuheng0101/X。
#!author=lylywayr
#!category=任务签到
#!arguments=cookie:true,hour:9,minute:0
#!arguments-desc=cookie：是否抓取 Cookie（抓到一次后设为 false，就不再进行抓取和 MITM 解密处理）；hour / minute：每日签到时间（默认 09:00，24 小时制）

[MITM]
hostname = %APPEND% www.52pojie.cn

[Script]
吾爱破解获取Cookie = type=http-request, pattern=^https:\/\/www\.52pojie\.cn\/home\.php\?, requires-body=0, max-size=1024, script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-Wuai_Checkin/wuai_cookie.js, argument="{{{cookie}}}", timeout=15, script-update-interval=0
吾爱破解签到 = type=cron, cronexp={{{minute}}} {{{hour}}} * * *, wake-system=1, script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/52pojie.js, timeout=60, script-update-interval=0
