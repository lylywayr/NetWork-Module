#!name=波点音乐 解锁
#!desc=波点音乐：会员状态调试 / 歌曲下载（支持付费专辑导出）/ 付费专辑解锁。去广告已拆分到「去广告合并」模块
#!author=WeiGiegie
#!homepage=https://github.com/WeiGiegie/666
#!category=解锁增强
#!system=iOS
#!desc2=本模块只做解锁与下载。广告接口（advert/banner/popup/gdt）已移除，由「去广告合并」模块接管；如需回退，把对应 URL 加回下面的 pattern 即可

[Script]
# 主脚本：会员调试 / 歌曲下载 / 付费专辑解锁
波点音乐解锁 = type=http-response,pattern=^https?:\/\/(?:(?:bd-api|h5app|bodianyin|ab-bodian)\.kuwo\.cn\/(?:api\/(?:ucenter\/users\/(?:pub|login)|play\/music\/v2\/(?:audioUrl|checkRight)|service\/(?:music\/(?:info|download\/(?:info|config))|home\/module|global\/config\/(?:scene|vipEnter))|search\/topic\/word\/list|pay\/(?:vip\/(?:invitation\/(?:assist\/popup|swell)|lowPriceText)|sp\/actVip|audition\/url)|abtest\/ui\/info|rec\/feed)|abtest\/ui\/info)),requires-body=true,max-size=2097152,timeout=60,script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-BodianMusic/bdyy.js

[MITM]
hostname = %APPEND% bd-api.kuwo.cn, *.kuwo.cn, bd-api.kuwo.com, *.kuwo.com, h5app.kuwo.cn, bodianimgcdn.kuwo.cn, h5s.kuwo.cn, ab-bodian.kuwo.cn
