#!name=IP 纯净度
#!desc=在「策略组」页面底部显示当前出口 IP 的纯净度：IPv4、归属地、ASN、线路类型（住宅·家宽 / 机房·云 / 移动网络）与风险等级。点右上角刷新按钮立即检测，或按 30 秒间隔自动更新。
#!system=ios
#!category=工具面板

[Panel]
IPPurity = script-name=ip-purity, title="IP 纯净度", content="点按右上角刷新按钮开始检测", style=info, update-interval=30

[Script]
ip-purity = type=generic, timeout=20, script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-IPPurity/ip-purity.js
