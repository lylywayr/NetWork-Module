#!name=小蚕霸王餐签到
#!desc=打开小蚕霸王餐 App 触发 RPC 请求自动抓参数，每天 08:00 自动签到。脚本来自 Sliverkiss。
#!author=lylywayr
#!category=签到任务
#!arguments=cookie:true
#!arguments-desc=cookie：是否抓取签到参数。抓到一次后可设为 false，脚本不再抓取、也不再弹通知

[MITM]
hostname = %APPEND% gw.xiaocantech.com

[Script]
小蚕霸王餐获取 = type=http-response, pattern=^https:\/\/gw\.xiaocantech\.com\/rpc, requires-body=0, argument="{{{cookie}}}", script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-%E5%B0%8F%E8%9A%95%E9%9C%B8%E7%8E%8B%E9%A4%90%E7%AD%BE%E5%88%B0/gate.js, script-update-interval=0
小蚕霸王餐定时 = type=cron, cronexp=0 8 * * *, wake-system=1, argument=xcbwc_data, script-path=https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Surge/%E6%A8%A1%E5%9D%97-%E5%B0%8F%E8%9A%95%E9%9C%B8%E7%8E%8B%E9%A4%90%E7%AD%BE%E5%88%B0/xcbwc.js, script-update-interval=0
