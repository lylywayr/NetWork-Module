#!name = 中国人保去广告
#!desc = 中国人保去除启动开屏、主页、我的、人保头条、猜你喜欢页面广告。
#!author = Sliverkiss
#!homepage = https://github.com/Sliverkiss/QuantumultX
#!icon = https://raw.githubusercontent.com/leiyiyan/resource/main/icons/picc.png
#!date = 2024-02-19 15:35:00

[Rewrite]
# 人保头条
^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/h\/headlines\/queryHeadlines reject-dict

# 启动开屏
^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/update\/startupPage\/v1 reject-dict

# 猜你喜欢
^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/guessYouLike\/v3 reject-dict

[Script]
# 主页
http-response ^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/homeInit\/v3 script-path = https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Loon/%E4%B8%AD%E5%9B%BD%E4%BA%BA%E4%BF%9D%E5%8E%BB%E5%B9%BF%E5%91%8A/picc_adblock.js, requires-body = true, tag = 主页去广告

# 我的页面
http-response ^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/mpageconfig\/myPageConfigList\/v3 script-path = https://raw.githubusercontent.com/lylywayr/NetWork-Module/main/Loon/%E4%B8%AD%E5%9B%BD%E4%BA%BA%E4%BF%9D%E5%8E%BB%E5%B9%BF%E5%91%8A/picc_adblock.js, requires-body = true, tag = 我的页面去广告


[MitM]
hostname = %APPEND% zgrb.epicc.com.cn
