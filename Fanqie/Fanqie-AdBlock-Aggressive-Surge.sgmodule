[URL Rewrite]
# Kelee 原始 HTTP 广告包规则；现代 HTTPS 场景命中率可能很低。
^http:\/\/p\d+-be-pack-sign\.pglstatp-toutiao\.com\/(ad-app-package|web\.business\.image)\/ - reject

[MITM]
# 无响应脚本，不需要 MitM。
